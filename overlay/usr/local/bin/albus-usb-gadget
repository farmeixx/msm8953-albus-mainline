#!/bin/sh
# Bring up the configfs USB gadget (RNDIS) of the albus mainline port.
# The device addresses itself as 10.15.0.1 and serves DHCP to the host,
# so ssh-over-USB works even before/without Wi-Fi.
set -eu

CONF=/sys/kernel/config/usb_gadget/g1
RUN=/run/usb-gadget

# Stop a dnsmasq instance from an earlier service run, if any.
if [ -f "$RUN/dnsmasq.pid" ]; then
	kill "$(cat "$RUN/dnsmasq.pid")" 2>/dev/null || true
	rm -f "$RUN/dnsmasq.pid"
fi

if ! grep -qs usb_gadget /proc/mounts; then
	mkdir -p /sys/kernel/config
	mount -t configfs none /sys/kernel/config || true
fi
if [ ! -d /sys/kernel/config/usb_gadget ]; then
	echo "usb-gadget: configfs unusable" >&2
	exit 1
fi

if [ ! -d "$CONF" ]; then
	mkdir "$CONF"
fi

printf '0x1d6b' > "$CONF/idVendor"
printf '0x0104' > "$CONF/idProduct"
printf '0x0100' > "$CONF/bcdUSB"
printf '0xEF' > "$CONF/bDeviceClass"
printf '0x02' > "$CONF/bDeviceSubClass"
printf '0x01' > "$CONF/bDeviceProtocol"
printf '0x0104' > "$CONF/bcdDevice"

# MS OS descriptors with the RNDIS compatible id: Windows then binds the
# net function natively (netrndis.inf) instead of running its stale
# driver-store INF matching, which produced CM_PROB_FAILED_INSTALL churn.
printf '0x1' > "$CONF/os_desc/use"
printf '0xcd' > "$CONF/os_desc/b_vendor_code"
printf 'MSFT100' > "$CONF/os_desc/qw_sign"

mkdir -p "$CONF/strings/0x409"
printf 'albus-mainline gadget' > "$CONF/strings/0x409/product"
printf 'Motorola (msm8953-mainline)' > "$CONF/strings/0x409/manufacturer"
printf 'albus' > "$CONF/strings/0x409/serialnumber"

# Multi-function gadget: RNDIS (legacy) + NCM (modern; Windows 10/11 bind
# natively) so the host can talk to us over either path.
mkdir -p "$CONF/configs/c.1/strings/0x409"
printf 'albus 10.15.0.1' > "$CONF/configs/c.1/strings/0x409/configuration"
printf '500' > "$CONF/configs/c.1/MaxPower"

if [ ! -d "$CONF/functions/rndis.0" ]; then
	mkdir "$CONF/functions/rndis.0"
fi
if [ ! -e "$CONF/configs/c.1/rndis.0" ]; then
	ln -s "$CONF/functions/rndis.0" "$CONF/configs/c.1/rndis.0"
fi
# Per-interface compatible ids (visible to Windows through os_desc).
if [ -d "$CONF/functions/rndis.0/os_desc/interface.rndis" ]; then
	printf 'RNDIS' > "$CONF/functions/rndis.0/os_desc/interface.rndis/compatible_id"
	printf 'RNDIS' > "$CONF/functions/rndis.0/os_desc/interface.rndis/sub_compatible_id"
fi
if [ ! -e "$CONF/os_desc/c.1" ]; then
	ln -s "$CONF/configs/c.1" "$CONF/os_desc/c.1"
fi
if [ ! -d "$CONF/functions/ncm.0" ]; then
	mkdir "$CONF/functions/ncm.0"
fi
if [ ! -e "$CONF/configs/c.1/ncm.0" ]; then
	ln -s "$CONF/functions/ncm.0" "$CONF/configs/c.1/ncm.0"
fi
if [ -d "$CONF/functions/ncm.0/os_desc/interface.ncm" ]; then
	printf 'NCM' > "$CONF/functions/ncm.0/os_desc/interface.ncm/compatible_id"
	printf 'NCM' > "$CONF/functions/ncm.0/os_desc/interface.ncm/sub_compatible_id"
fi

UDC="$(ls /sys/class/udc 2>/dev/null | head -n1)"
if [ -z "$UDC" ]; then
	echo "usb-gadget: no UDC device found" >&2
	exit 1
fi
CURRENT="$(cat "$CONF/UDC" 2>/dev/null || true)"
if [ "$CURRENT" != "$UDC" ]; then
	echo "$UDC" > "$CONF/UDC"
fi

# Every gadget-function netdev (rndis/ncm/ecm) shows up under
# /sys/class/net with a gadget device path; wire them all up.
DEVS=""
for n in /sys/class/net/*; do
	case "$(readlink -f "$n" 2>/dev/null)" in
	*gadget*) DEVS="$DEVS $(basename "$n")" ;;
	esac
done

if [ -z "$DEVS" ]; then
	echo "usb-gadget: no gadget network interface appeared" >&2
	exit 1
fi

IFLIST=""
for DEV in $DEVS; do
	ip addr replace 10.15.0.1/24 dev "$DEV"
	ip link set "$DEV" up
	IFLIST="$IFLIST interface=$DEV"
done

mkdir -p /run/usb-gadget
cat > "$RUN/dnsmasq.conf" <<EOF
# Generated by albus-usb-gadget (interfaces:$IFLIST)
$IFLIST
bind-dynamic
dhcp-authoritative
dhcp-range=10.15.0.50,10.15.0.200,255.255.255.0,12h
dhcp-option=3,10.15.0.1
dhcp-option=6,10.15.0.1
no-resolv
server=1.1.1.1
server=8.8.8.8
EOF

echo "usb-gadget:$IFLIST up as 10.15.0.1 (UDC ${UDC})"
