From 9565e0366ca6891e0703755b20d842206a7e9f58 Mon Sep 17 00:00:00 2001
From: SaaS <hearesaas@gmail.com>
Date: Fri, 6 Nov 2026 05:11:06 -0400
Subject: [PATCH 2/2] arm64: configs: qcom: msm8953: add Motorola Moto Z2 Play
 config fragment

---
 arch/arm64/configs/motorola-albus.config | 29 ++++++++++++++++++++++++
 1 file changed, 29 insertions(+)
 create mode 100755 arch/arm64/configs/motorola-albus.config

diff --git a/arch/arm64/configs/motorola-albus.config b/arch/arm64/configs/motorola-albus.config
new file mode 100755
index 0000000..56159aa
--- /dev/null
+++ b/arch/arm64/configs/motorola-albus.config
@@ -0,0 +1,29 @@
+CONFIG_LOCALVERSION="-Albus-Revived"
+# CONFIG_LOCALVERSION_AUTO is not set
+
+# Debian root on the userdata partition, no initramfs.
+CONFIG_EXT4_FS=y
+CONFIG_EXT4_FS_POSIX_ACL=y
+CONFIG_EXT4_FS_SECURITY=y
+
+# GPIO keys (volume up) and RNDIS gadget for ssh-over-USB.
+CONFIG_KEYBOARD_GPIO=y
+CONFIG_USB_DWC3_QCOM=y
+CONFIG_USB_DWC3_DUAL_ROLE=y
+CONFIG_USB_LIBCOMPOSITE=y
+CONFIG_USB_CONFIGFS=y
+CONFIG_USB_CONFIGFS_RNDIS=y
+# The albus gadget is RNDIS-only; do not build unused gadget functions.
+# CONFIG_USB_CONFIGFS_SERIAL is not set
+# CONFIG_USB_CONFIGFS_ACM is not set
+# CONFIG_USB_CONFIGFS_OBEX is not set
+# CONFIG_USB_CONFIGFS_NCM is not set
+# CONFIG_USB_CONFIGFS_ECM is not set
+# CONFIG_USB_CONFIGFS_ECM_SUBSET is not set
+# CONFIG_USB_CONFIGFS_EEM is not set
+# CONFIG_USB_CONFIGFS_MASS_STORAGE is not set
+# CONFIG_USB_CONFIGFS_F_FS is not set
+# CONFIG_USB_F_ACM is not set
+
+# Charging LED.
+CONFIG_LEDS_ATC=m
